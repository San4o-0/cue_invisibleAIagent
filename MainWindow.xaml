<Window x:Class="LiveTranscriber.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cue"
        Icon="pack://application:,,,/Assets/cue.ico"
        Width="1150" Height="740" MinWidth="920" MinHeight="480"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResize"
        Background="Transparent" Foreground="#E6EEF2"
        FontFamily="pack://application:,,,/Fonts/#Manrope" FontSize="14"
        Closing="OnClosing">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="0"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <FontFamily x:Key="BrandFont">pack://application:,,,/Fonts/#Manrope</FontFamily>
        <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

        <SolidColorBrush x:Key="PanelBrush" Color="#0F1A22" />
        <SolidColorBrush x:Key="FieldBrush" Color="#16242D" />
        <SolidColorBrush x:Key="LineBrush" Color="#26404C" />
        <SolidColorBrush x:Key="LineHoverBrush" Color="#3A5A6A" />
        <SolidColorBrush x:Key="HoverBrush" Color="#1E3340" />
        <SolidColorBrush x:Key="InkBrush" Color="#E6EEF2" />
        <SolidColorBrush x:Key="MistBrush" Color="#8FA3AE" />
        <SolidColorBrush x:Key="HintBrush" Color="#7A919D" />
        <SolidColorBrush x:Key="NightBrush" Color="#0F1A22" />
        <SolidColorBrush x:Key="CueBrush" Color="#3FD1C7" />
        <SolidColorBrush x:Key="CueHoverBrush" Color="#6ADDD5" />
        <SolidColorBrush x:Key="StandbyBrush" Color="#F5B84A" />
        <SolidColorBrush x:Key="AlertBrush" Color="#FF6B6B" />

        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource LineHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource CueBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource CueBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CueBrush}" />
            <Setter Property="Foreground" Value="{StaticResource NightBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource CueHoverBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource CueHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource InkBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Foreground" Value="{StaticResource MistBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AlertBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource NightBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CueCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource MistBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="17" Height="17" CornerRadius="5" BorderThickness="1.5"
                                    BorderBrush="{StaticResource LineHoverBrush}" Background="Transparent" VerticalAlignment="Center">
                                <TextBlock x:Name="Mark" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                           Foreground="{StaticResource NightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="8,0,0,1" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource MistBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource CueBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource CueBrush}" />
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="CaretBrush" Value="{StaticResource CueBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource CueBrush}" />
            <Setter Property="SelectionOpacity" Value="0.35" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource LineHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource CueBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="CaretBrush" Value="{StaticResource CueBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource CueBrush}" />
            <Setter Property="SelectionOpacity" Value="0.35" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource LineHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource CueBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{StaticResource CueBrush}" />
            <Setter Property="TextDecorations" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource CueHoverBrush}" />
                    <Setter Property="TextDecorations" Value="Underline" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ScrollPage" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bar" Background="{StaticResource LineBrush}" CornerRadius="3" Margin="2" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bar" Property="Background" Value="{StaticResource LineHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="MinWidth" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" ViewportSize="NaN">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPage}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPage}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" Height="40" />
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Height" Value="10" />
                    <Setter Property="MinHeight" Value="10" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Track x:Name="PART_Track" IsDirectionReversed="False" ViewportSize="NaN">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollPage}" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollPage}" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}" Width="40" />
                                    </Track.Thumb>
                                </Track>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SliderPart" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CueSlider" TargetType="Slider">
            <Setter Property="Height" Value="22" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderPart}" Background="{StaticResource CueBrush}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderPart}" Background="{StaticResource LineBrush}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="14" Height="14">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="{StaticResource InkBrush}" Stroke="{StaticResource NightBrush}" StrokeThickness="2" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource BrandFont}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="#16242D" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="10,7" MaxWidth="340">
                            <ContentPresenter>
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                        <Setter Property="LineHeight" Value="18" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource MistBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource HintBrush}" />
            <Setter Property="Margin" Value="13,10" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="21" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag.Text, RelativeSource={RelativeSource Self}}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Height="40" Margin="14,0,6,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource CloseButton}" Content="&#xE8BB;"
                        ToolTip="Закрити Cue" Click="OnCloseWindow" />
                <Button DockPanel.Dock="Right" Style="{StaticResource CaptionButton}" Content="&#xE921;"
                        ToolTip="Згорнути" Click="OnMinimize" />
                <Button x:Name="PinButton" DockPanel.Dock="Right" Style="{StaticResource CaptionButton}"
                        FontSize="13" Click="OnTogglePin" />
                <Button x:Name="CaptureIconButton" DockPanel.Dock="Right" Style="{StaticResource CaptionButton}"
                        FontSize="15" Click="OnToggleCapture" />
                <TextBlock x:Name="TransparencyText" DockPanel.Dock="Right" Style="{StaticResource Muted}"
                           Width="38" Margin="6,0,10,0" TextAlignment="Right" />
                <Slider x:Name="TransparencySlider" DockPanel.Dock="Right" Width="120" VerticalAlignment="Center"
                        Style="{StaticResource CueSlider}"
                        Minimum="0" Maximum="80" SmallChange="5" LargeChange="10"
                        TickFrequency="5" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        ToolTip="Наскільки прозорий фон вікна. Текст лишається чітким" />
                <TextBlock x:Name="TransparencyLabel" DockPanel.Dock="Right" Style="{StaticResource Muted}"
                           Margin="0,0,10,0" Text="Прозорість" />

                <Border x:Name="Logo" DockPanel.Dock="Left" Background="Transparent" VerticalAlignment="Center"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Viewbox Width="24" Height="24">
                    <Canvas Width="64" Height="64">
                        <Path Fill="{StaticResource InkBrush}"
                              Data="M30,8C36.63,8,42.63,10.69,46.97,15.03L48.3,16.64 39.91,23.68 39.19,22.81C36.84,20.46 33.59,19 30,19 22.82,19 17,24.82 17,32 17,39.18 22.82,45 30,45C33.59,45,36.84,43.54,39.19,41.19L39.91,40.32 48.3,47.36 46.97,48.97C42.63,53.31,36.63,56,30,56C26.69,56,23.53,55.33,20.66,54.11L18.97,53.2 5,60 10.54,45.96 10.1,45.42C7.51,41.59 6,36.97 6,32 6,18.75 16.75,8 30,8z" />
                        <Ellipse x:Name="LogoLight" Canvas.Left="46.5" Canvas.Top="25.5" Width="13" Height="13"
                                 Fill="{StaticResource CueBrush}" />
                    </Canvas>
                </Viewbox>
                </Border>
                <TextBlock x:Name="TitleText" DockPanel.Dock="Left" Text="cue" FontSize="19" FontWeight="ExtraBold"
                           VerticalAlignment="Center" Margin="8,0,0,3" />
                <TextBlock x:Name="StateText" DockPanel.Dock="Left" Style="{StaticResource Muted}" Margin="12,1,20,0" />
                <CheckBox x:Name="AnswersOnlyBox" Style="{StaticResource CueCheckBox}" HorizontalAlignment="Left"
                          Margin="12,0,0,0" Content="Лише підказки"
                          Checked="OnAnswersOnlyChanged" Unchecked="OnAnswersOnlyChanged"
                          ToolTip="Сховати все, крім підказок. Гаряча клавіша працює як і раніше" />
            </DockPanel>

            <Grid Margin="14,6,14,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel x:Name="ControlsBar" Grid.Row="0" Margin="0,0,0,12">
                    <Button x:Name="AskButton" DockPanel.Dock="Left" Margin="0" Padding="16,8,10,8"
                            Style="{StaticResource PrimaryButton}" Click="OnAsk"
                            ToolTip="Cue візьме останні секунди розмови й дасть коротку відповідь на питання">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Підказати" VerticalAlignment="Center" FontSize="14" />
                            <Border x:Name="AskHotkeyChip" Margin="12,0,0,0" Padding="7,2" CornerRadius="6" Background="#1A0F1A22">
                                <TextBlock x:Name="AskHotkeyText" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button x:Name="PauseButton" DockPanel.Dock="Left" Click="OnPause">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="PauseIcon" Style="{StaticResource Icon}" FontSize="11" />
                            <TextBlock x:Name="PauseText" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CaptureButton" DockPanel.Dock="Left" Click="OnToggleCapture">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="CaptureIcon" Style="{StaticResource Icon}" FontSize="14" />
                            <TextBlock x:Name="CaptureText" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsButton" DockPanel.Dock="Right" Click="OnToggleSettings"
                            ToolTip="Гаряча клавіша і скільки розмови брати для підказки">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" />
                            <TextBlock Text="Налаштування" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Border />
                </DockPanel>

                <Border x:Name="SettingsPanel" Grid.Row="1" Margin="0,0,0,12" Padding="16,12" CornerRadius="10"
                        Background="{DynamicResource FieldBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                        Visibility="Collapsed">
                    <StackPanel>
                    <WrapPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,32,0">
                            <TextBlock Style="{StaticResource Muted}" FontSize="13.5" Foreground="{StaticResource InkBrush}"
                                       Margin="0,0,10,0" Text="Гаряча клавіша" />
                            <TextBox x:Name="HotkeyBox" Width="150" IsReadOnly="True" Cursor="Hand" TextWrapping="NoWrap"
                                     HorizontalContentAlignment="Center" Padding="8,6"
                                     ToolTip="Клацни сюди й натисни нову комбінацію. Esc — скасувати"
                                     PreviewKeyDown="OnHotkeyKeyDown"
                                     GotKeyboardFocus="OnHotkeyFocus"
                                     LostKeyboardFocus="OnHotkeyBlur" />
                            <TextBlock Style="{StaticResource Muted}" Margin="10,0,0,0" Text="працює в будь-якому вікні" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Muted}" FontSize="13.5" Foreground="{StaticResource InkBrush}"
                                       Margin="0,0,10,0" Text="Брати останні" />
                            <TextBox x:Name="SecondsBox" Width="58" TextWrapping="NoWrap" HorizontalContentAlignment="Center"
                                     Padding="6,6"
                                     ToolTip="Скільки останніх секунд розмови Cue бере для підказки (5–1800). Enter — застосувати"
                                     PreviewTextInput="OnSecondsInput"
                                     KeyDown="OnSecondsKeyDown"
                                     LostKeyboardFocus="OnSecondsBlur" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="13.5" Foreground="{StaticResource InkBrush}"
                                       Margin="10,0,0,0" Text="секунд розмови" />
                        </StackPanel>
                    </WrapPanel>

                    <Border Height="1" Margin="0,12" Background="{StaticResource LineBrush}" />

                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Muted}" FontSize="13.5" Foreground="{StaticResource InkBrush}"
                                   Margin="0,0,10,0" Text="Ключ OpenAI" />
                        <Grid Width="300">
                            <PasswordBox x:Name="ApiKeyBox" PasswordChanged="OnApiKeyChanged" KeyDown="OnApiKeyKeyDown"
                                         ToolTip="Ключ зберігається зашифрованим лише на цьому комп'ютері й іде тільки в OpenAI" />
                            <TextBlock x:Name="ApiKeyHint" Style="{StaticResource Muted}" Foreground="{StaticResource HintBrush}"
                                       Margin="12,0" IsHitTestVisible="False" Text="Встав ключ, що починається з sk-" />
                        </Grid>
                        <Button x:Name="SaveKeyButton" Content="Зберегти" Padding="12,5" FontSize="12.5" Click="OnSaveApiKey" />
                        <Button x:Name="DeleteKeyButton" Content="Видалити" Padding="12,5" FontSize="12.5" Click="OnDeleteApiKey"
                                ToolTip="Видалити збережений ключ з цього комп'ютера" />
                        <TextBlock x:Name="ApiKeyStatus" Style="{StaticResource Muted}" Margin="14,0,14,0" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="13">
                            <Hyperlink NavigateUri="https://platform.openai.com/api-keys" RequestNavigate="OnOpenLink">Де взяти ключ</Hyperlink>
                        </TextBlock>
                    </WrapPanel>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="LeftColumn" Width="2*" MinWidth="260" />
                        <ColumnDefinition x:Name="SplitterColumn" Width="14" />
                        <ColumnDefinition Width="3*" MinWidth="320" />
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="LeftPanel" Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="3*" MinHeight="90" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="2*" MinHeight="90" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="Очистити" Padding="12,5" FontSize="12.5" Click="OnClearTranscript"
                                    ToolTip="Очистити текст на екрані. Запис розмови у файлі залишиться" />
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Розмова" />
                            <TextBlock Style="{StaticResource Muted}" Margin="10,1,0,0" Text="що звучить у навушниках" />
                        </DockPanel>
                        <TextBox x:Name="TranscriptBox" Grid.Row="1" IsReadOnly="True" />
                        <TextBlock Grid.Row="1" Style="{StaticResource Hint}" Tag="{Binding ElementName=TranscriptBox}"
                                   Text="Тут наживо з'являтиметься все, що говорять у дзвінку чи відео. Свій мікрофон Cue не слухає." />

                        <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                      ResizeDirection="Rows" Background="Transparent" />

                        <DockPanel Grid.Row="3" Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="Очистити" Padding="12,5" FontSize="12.5" Click="OnClearContext" />
                            <Button DockPanel.Dock="Right" Content="+ Папка" Padding="12,5" FontSize="12.5" Click="OnAddFolder"
                                    ToolTip="Додати цілий проєкт. Cue візьме лише код і тексти, без службових папок" />
                            <Button DockPanel.Dock="Right" Content="+ Файл" Padding="12,5" FontSize="12.5" Click="OnAddFile" />
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Матеріали" />
                            <TextBlock x:Name="ContextSizeText" Style="{StaticResource Muted}" Margin="10,1,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="Приблизний обсяг матеріалів. Вони йдуть разом із кожним запитом" />
                        </DockPanel>
                        <TextBox x:Name="ContextBox" Grid.Row="4" AcceptsReturn="True" AcceptsTab="True" AllowDrop="True"
                                 TextChanged="OnContextChanged"
                                 PreviewDragOver="OnContextDragOver" PreviewDrop="OnContextDrop" />
                        <TextBlock Grid.Row="4" Style="{StaticResource Hint}" Tag="{Binding ElementName=ContextBox}"
                                   Text="Додай резюме, нотатки чи цілий проєкт: встав текст або перетягни сюди файли й папки. Cue спиратиметься на них у підказках." />
                    </Grid>

                    <GridSplitter x:Name="ColumnSplitter" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  ResizeDirection="Columns" Background="Transparent" />

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel x:Name="AnswersHeader" Grid.Row="0" Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="Почати заново" Padding="12,5" FontSize="12.5" Click="OnClearAnswers"
                                    ToolTip="Очистити підказки. Cue забуде попередні відповіді й почне з чистого аркуша" />
                            <Button DockPanel.Dock="Right" Content="Копіювати" Padding="12,5" FontSize="12.5" Click="OnCopyLast"
                                    ToolTip="Скопіювати останню підказку" />
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Підказки" />
                        </DockPanel>
                        <TextBox x:Name="AnswersBox" Grid.Row="1" IsReadOnly="True" FontSize="15.5" Padding="14,12" />
                        <TextBlock x:Name="AnswersHint" Grid.Row="1" Style="{StaticResource Hint}" Margin="17,14"
                                   FontSize="15" LineHeight="23" Tag="{Binding ElementName=AnswersBox}" />
                    </Grid>
                </Grid>

                <DockPanel x:Name="QuestionBar" Grid.Row="3" Margin="0,12,0,0">
                    <Button DockPanel.Dock="Right" Content="Спитати" Click="OnSend" />
                    <Grid>
                        <TextBox x:Name="QuestionBox" MinHeight="40" MaxHeight="120" VerticalContentAlignment="Center"
                                 KeyDown="OnQuestionKeyDown" />
                        <TextBlock Style="{StaticResource Hint}" Tag="{Binding ElementName=QuestionBox}" Margin="13,0"
                                   VerticalAlignment="Center" Text="Спитай Cue своїми словами. Enter — надіслати" />
                    </Grid>
                </DockPanel>

                <TextBlock x:Name="StatusText" Grid.Row="4" Margin="2,10,0,0" Style="{StaticResource Muted}"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </DockPanel>
    </Border>
</Window>
